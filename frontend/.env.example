# Kakao Developers > App > JavaScript key.
# Register http://localhost:3000 as a JavaScript SDK domain.
# Copy to .env.local. Only the JavaScript key goes in this public variable.
NEXT_PUBLIC_KAKAO_MAP_KEY=

# Korea Tourism Organization TourAPI service key (encoded or decoded).
# Server-only: never prefix this key with NEXT_PUBLIC_.
TOUR_API_KEY=

# Server-only route directions (walking, driving, public transit)
KAKAO_REST_API_KEY=
